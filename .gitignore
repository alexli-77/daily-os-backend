.env
config/config.yaml
memory-vault/default/decision-policy.md
memory-vault/default/decision-policy.yaml
memory-vault/default/rhythm.md
data/**
!data/.gitkeep
!data/memory/
!data/memory/.gitkeep
!data/memory/daily/
!data/memory/daily/.gitkeep
!data/snapshots/
!data/snapshots/**/
!data/snapshots/**/*.example
!data/logs/
data/logs/*
!data/logs/.gitkeep
/logs/
backups/
*.pre-restore-*
dist/
node_modules/
.DS_Store
*.sqlite
*.sqlite-shm
*.sqlite-wal
# Any sidecar of the real config, not just the timestamped .bak- ones: these
# hold live credentials, and a pattern that only covers the naming convention
# someone happened to use last time is one improvised suffix away from a leak.
config/config.yaml.*
!config/config.yaml.example
